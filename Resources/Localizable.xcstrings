            "value": "開いているすべての画像を保存して閉じる"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сохранить все открытые изображения и закрыть"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "存储所有已打开的图像并关闭"
          }
        }
      }
    },
    "Save as new": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistrer comme nouveau"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "新規として保存"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сохранить как новый"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "存储为新模板"
          }
        }
      }
    },
    "Save the current setup to \"%@\"?": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistrer la configuration actuelle dans « %@ » ?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在の設定を「%@」に保存しますか？"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сохранить текущие настройки в «%@»?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "要将当前设置存储到“%@”吗？"
          }
        }
      }
    },
    "Save, close and copy the image to your clipboard": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistrer, fermer et copier l’image dans le presse-papiers"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存して閉じ、画像をクリップボードにコピー"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сохранить, закрыть и скопировать изображение в буфер обмена"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "存储、关闭并将图像拷贝到剪贴板"
          }
        }
      }
    },
    "Saving back to one of these formats just works: SimplShot keeps the original format where it can, and offers Save As when a format can only be opened, not written.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’enregistrement dans ces formats fonctionne simplement : SimplShot conserve le format d’origine lorsque c’est possible, et propose « Enregistrer sous » quand un format peut seulement être ouvert et non écrit."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これらのフォーマットへの保存もそのまま行えます。SimplShotは可能なかぎり元のフォーマットを保ち、開くことしかできないフォーマットの場合は「別名で保存」を提示します。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сохранение обратно в эти форматы просто работает: SimplShot по возможности сохраняет исходный формат, а когда формат можно только открыть, предлагает «Сохранить как»."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "存储回这些格式也毫无障碍：SimplShot 会尽可能保留原始格式；若某种格式只能打开而无法写入，则会提供“存储为”。"
          }
        }
      }
    },
    "Scale:": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Échelle :"
          }
