    "Bendable arrows — select a Curved arrow and drag the new dot in the middle to shape the curve exactly how you want it.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Flèches déformables — sélectionnez une flèche courbe et faites glisser le nouveau point central pour donner à la courbe exactement la forme voulue."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "曲げられる矢印 — 曲線の矢印を選択し、中央に追加された点をドラッグすると、カーブを思いどおりの形にできます。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Гибкие стрелки — выберите изогнутую стрелку и потяните новую точку посередине, чтобы задать изгиб именно таким, как нужно."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可弯曲的箭头——选择曲线箭头，拖移中间新增的圆点，即可将弧度调整成您想要的形状。"
          }
        }
      }
    },
