    "Alignment and ratio" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ausrichtung und Seitenverhältnis"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alignement et format"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "配置とアスペクト比"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выравнивание и пропорции"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "对齐与比例"
          }
        }
      }
    },
    "Alignment now keeps padding even — aligning to an edge puts the screenshot flush against it while the other sides keep their exact padding, instead of doubling the gap on the opposite side." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Ausrichtung hält den Abstand jetzt gleichmäßig — bei Ausrichtung an einer Kante liegt das Bildschirmfoto bündig an, während die übrigen Seiten ihren exakten Abstand behalten, statt die Lücke auf der Gegenseite zu verdoppeln."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'alignement conserve désormais des marges régulières — aligner sur un bord place la capture au ras de celui-ci tandis que les autres côtés gardent leur marge exacte, au lieu de doubler l'espace du côté opposé."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "整列時の余白が均等になりました — 端に整列するとスクリーンショットはその端にぴったり付き、他の辺は正確な余白を保ちます。反対側の余白が倍になることはもうありません。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выравнивание теперь сохраняет равные отступы — при выравнивании по краю снимок прижимается к нему вплотную, а остальные стороны сохраняют точный отступ вместо удвоенного зазора с противоположной стороны."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "对齐现在保持四周边距均匀 — 对齐到某一边时截图会紧贴该边，其余各边保持精确的边距，不再在对侧留下双倍空隙。"
          }
        }
      }
    },
    "All unsaved annotations and adjustments will be lost." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle nicht gesicherten Anmerkungen und Anpassungen gehen verloren."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toutes les annotations et retouches non enregistrées seront perdues."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "保存されていない注釈と調整はすべて失われます。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Все несохранённые аннотации и коррекции будут потеряны."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "所有未保存的标注和调整都将丢失。"
          }
        }
      }
    },
