    "Enter a name for this template.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saisissez un nom pour ce modèle."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このテンプレートの名前を入力してください。"
          }
        },
