    "Text Copied": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Texte copié"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "テキストをコピーしました"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Текст скопирован"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "文字已拷贝"
          }
        }
      }
    },
    "The file will be moved to the Trash.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le fichier sera placé dans la corbeille."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ファイルはゴミ箱に移動されます。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Файл будет перемещён в Корзину."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "文件将被移到废纸篓。"
          }
        }
      }
    },
    "The focus ring on the Annotate · Edit · View switch now follows the segment you actually clicked, instead of staying stuck on whichever one had it first.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’anneau de focus du sélecteur Annoter · Modifier · Visualiser suit désormais le segment sur lequel vous avez réellement cliqué, au lieu de rester bloqué sur le premier qui l’avait obtenu."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「注釈・編集・表示」スイッチのフォーカスリングが、最初にフォーカスを得たセグメントに留まらず、実際にクリックしたセグメントへ移動するようになりました。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Рамка фокуса на переключателе «Аннотации · Правка · Просмотр» теперь следует за сегментом, по которому вы нажали, а не остаётся на том, который получил её первым."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“标注 · 编辑 · 查看”切换控件上的聚焦框现在会跟随您实际点按的分段，而不再停留在最先获得聚焦的那一个上。"
          }
        }
      }
    },
    "The password for “%@” was incorrect. Please try again.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le mot de passe de « %@ » est incorrect. Veuillez réessayer."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」のパスワードが正しくありません。もう一度お試しください。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Неверный пароль для «%@». Попробуйте ещё раз."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”的密码不正确，请重试。"
          }
        }
      }
    },
    "This image format can be opened but not written. Use “Save As…” to choose a format.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce format d’image peut être ouvert mais pas écrit. Utilisez « Enregistrer sous… » pour choisir un format."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この画像フォーマットは開けますが、書き出しはできません。「別名で保存…」でフォーマットを選択してください。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этот формат можно открыть, но не сохранить. Выберите другой формат через «Сохранить как…»."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此图像格式只能打开，无法写入。请使用“存储为…”选择其他格式。"
          }
        }
      }
    },
    "This replaces every other open image's background and effects with the current image's style. Annotations, crops and photo adjustments are kept.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela remplace l’arrière-plan et les effets de toutes les autres images ouvertes par le style de l’image actuelle. Les annotations, rognages et retouches sont conservés."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "開いている他のすべての画像の背景とエフェクトが、現在の画像のスタイルに置き換わります。注釈、トリミング、写真調整はそのまま保持されます。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Фон и эффекты всех остальных открытых изображений будут заменены стилем текущего изображения. Аннотации, кадрирование и коррекции сохранятся."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这会将其他所有已打开图像的背景和效果替换为当前图像的样式。标注、裁剪和照片调整将会保留。"
          }
        }
      }
    },
    "Thumbnails in the open-images strip now update live as you restyle an image, so they always match what you see.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les vignettes de la bande d’images ouvertes se mettent désormais à jour en direct lorsque vous modifiez le style d’une image, et correspondent donc toujours à ce que vous voyez."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "開いている画像のストリップにあるサムネールが、スタイルを変更するたびにリアルタイムで更新され、常に表示内容と一致するようになりました。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Миниатюры в полосе открытых изображений теперь обновляются на лету при изменении оформления, поэтому всегда совпадают с тем, что вы видите."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已打开图像栏中的缩略图现在会随着样式更改实时更新，始终与您看到的画面保持一致。"
          }
        }
      }
    },
