    "Crop": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rogner"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "トリミング"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Кадрировать"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
