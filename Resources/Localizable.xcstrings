    "Straighten" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ausrichten"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Redresser"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "傾き補正"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выравнивание"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "校正"
          }
        }
      }
    },
    "Straighten tool — while cropping, drag the new Straighten slider to level a tilted screenshot in 1° steps. The crop tightens automatically so you never get blank corners, and an alignment grid appears while you adjust to help you line things up." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Werkzeug „Ausrichten“ — ziehe beim Zuschneiden am neuen Regler „Ausrichten“, um ein schiefes Bildschirmfoto in 1°-Schritten gerade zu rücken. Der Zuschnitt wird automatisch enger gefasst, sodass nie leere Ecken entstehen, und während des Anpassens erscheint ein Raster als Hilfe beim Ausrichten."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Outil de redressement — pendant le rognage, faites glisser le nouveau curseur Redresser pour remettre d’aplomb une capture inclinée, par pas de 1°. Le rognage se resserre automatiquement, ce qui évite tout coin vide, et une grille d’alignement apparaît pendant le réglage pour vous aider à cadrer."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "傾き補正ツール — トリミング中に新しい「傾き補正」スライダをドラッグすると、傾いたスクリーンショットを1°刻みで水平にできます。トリミング範囲は自動的に調整されるので余白の角ができることはなく、調整中は位置合わせ用のグリッドが表示されます。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Инструмент выравнивания — при кадрировании потяните новый бегунок «Выравнивание», чтобы выровнять наклонённый снимок с шагом 1°. Область кадра автоматически подтягивается, поэтому пустых углов не будет, а во время настройки появляется сетка, помогающая выровнять кадр."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "校正工具——裁剪时拖移新增的“校正”滑块，即可以 1° 为步长把倾斜的截图摆正。裁剪范围会自动收紧，因此绝不会出现空白边角；调整过程中还会显示对齐网格，帮助您对准画面。"
          }
        }
      }
    },
