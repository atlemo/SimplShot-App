    "Screenshots without a background again show with subtle rounded corners and a soft drop shadow, matching the look used for PDF pages.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les captures sans arrière-plan s’affichent à nouveau avec de discrets coins arrondis et une ombre portée douce, comme les pages PDF."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "背景なしのスクリーンショットが、PDFページと同じように、控えめな角丸とやわらかいドロップシャドウ付きで再び表示されるようになりました。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Снимки без фона снова отображаются с лёгким скруглением углов и мягкой тенью — так же, как страницы PDF."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不带背景的截图重新显示为带有淡淡圆角和柔和投影的样式，与 PDF 页面的外观保持一致。"
          }
        }
      }
    },
