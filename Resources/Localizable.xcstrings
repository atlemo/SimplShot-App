          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "全部应用"
          }
        }
      }
    },
    "Apply to all images": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Appliquer à toutes les images"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべての画像に適用"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Применить ко всем изображениям"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "应用到所有图像"
          }
        }
      }
    },
    "Apply to all open images?": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Appliquer à toutes les images ouvertes ?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "開いているすべての画像に適用しますか？"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Применить ко всем открытым изображениям?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "应用到所有已打开的图像？"
          }
        }
      }
    },
    "Applying a saved template no longer nudges your annotations out of place — they keep their position relative to the screenshot when the padding, background, aspect ratio and alignment all change at once.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’application d’un modèle enregistré ne décale plus vos annotations : elles conservent leur position par rapport à la capture, même lorsque la marge, l’arrière-plan, le format et l’alignement changent tous en même temps."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存したテンプレートを適用しても注釈がずれなくなりました — 余白、背景、アスペクト比、配置が一度に変わっても、注釈はスクリーンショットに対する位置を保ちます。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Применение сохранённого шаблона больше не смещает аннотации — они сохраняют положение относительно снимка, даже когда отступы, фон, пропорции и выравнивание меняются одновременно."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "应用已存储的模板不会再让标注偏移——即使边距、背景、宽高比和对齐方式同时改变，标注仍会保持相对于截图的位置。"
          }
        }
      }
    },
